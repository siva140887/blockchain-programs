/* upgradeable smart contract code for simple library management system using the openzeppelin library */

pragma solidity >=0.8.2 <0.9.0;

// importing openzeppelin library

import "@openzeppelin/contracts-upgradeable/proxy/utils/UUPSUpgradeable.sol"; 
import "@openzeppelin/contracts-upgradeable/access/OwnableUpgradeable.sol";

contract Library is UUPSUpgradeable, OwnableUpgradeable		/* inheriting UUPSUpgradeable and OwnableUpgradeable contracts */
{
    address clibrarian;
    struct Book
    {
        string book_name;
        uint count;
    }
    Book[] books;
    mapping(address=>uint) public borrowers;

 modifier isclibrarian() {
    require(msg.sender==clibrarian,"The caller is not clibrarian");
    _;
 }   

/* The following function permits secure or authorized contract upgrades. Only the contract owner can initiate contract upgrades */

function _authorizeUpgrade(address newImplementation) internal override onlyOwner()
{

}

// The following function serves the purpose of a constructor

function initialize (string[] memory bnames, uint[] memory bcounts) public initializer	/* initializer is a modifier to ensure the function is invocable only once */	
{
   __Ownable_init(msg.sender);
   //__UUPSUpgradeable_init();
   clibrarian = msg.sender;
  
  uint i;
  for(i=0;i<bnames.length;i++)
  {
    books.push(Book({book_name: bnames[i],count: bcounts[i]}));
  }
}

function borrow(uint bindex) public
{
    require(books[bindex].count!=0,"The book is out of stock");
    require(borrowers[msg.sender]<2,"The borrow limit is reached");
    books[bindex].count--;
    borrowers[msg.sender]++;
}

function return1(uint bindex) public returns(string memory)
{
string memory m1 = "You";
string memory m2 = "No more books to return";
books[bindex].count++;
borrowers[msg.sender]--;

if(borrowers[msg.sender]>0)
return m1;
else 
return m2;
}

function catalogue() public view isclibrarian returns (Book[] memory)			
{
return books;
}

}




