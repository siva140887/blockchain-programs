/* smart contract code for simple library management system with borrow, return, and view catalogue functionalities */

pragma solidity >=0.8.2 <0.9.0;

contract Library
{
    address clibrarian;		// holds chief librarian address who is also the contract deployer
    struct Book
    {
        string book_name;
        uint count;
    }		// structure "Book" for book
    Book[] books;	// books is a dynamic array. This is to represent books in the catalogue
    mapping(address=>uint) public borrowers;		/* mapping is a data structure similar to hash table. It contains key-value pairs. In this case, borrowers is the mapping data structure with blockchain addresses as keys and borrowlimit as the values */

 modifier isclibrarian() {		// user-defined modifier that checks if the caller is the chief librarian
    require(msg.sender==clibrarian,"The caller is not clibrarian");
    _;
 }   

constructor(string[] memory bnames, uint[] memory bcounts)	/* parameterized constructor that takes book names and their counts */
{
   clibrarian = msg.sender;		// capturing the address of the contract deployer
  
  // Initializing books dynamic array with the book names and counts
  uint i;
  for(i=0;i<bnames.length;i++)
  {
    books.push(Book({book_name: bnames[i],count: bcounts[i]}));
  }
}

function borrow(uint bindex) public		// borrow function that takes book index as parameter
{
    require(books[bindex].count!=0,"The book is out of stock");
    require(borrowers[msg.sender]<2,"The borrow limit is reached");
    books[bindex].count--;	// book count is decremented
    borrowers[msg.sender]++;	// borrower's borrow limit is incremented
}

function return1(uint bindex) public returns(string memory)		/* return function that takes book index as parameter */
{
string memory m1 = "You have books to return";
string memory m2 = "No more books to return";
books[bindex].count++;
borrowers[msg.sender]--;
// provision to indicate whether or not the borrower has any more books to return
if(borrowers[msg.sender]>0)
return m1;
else 
return m2;
}

function catalogue() public view isclibrarian returns (Book[] memory)		/* This function is to view the catalogue. isclibrarian modifier checks if the caller is chief librarian */	
{
return books;
}

}




